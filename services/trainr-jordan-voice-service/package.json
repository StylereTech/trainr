  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "prom-client": "^15.1.3",
    "twilio": "^5.4.2",
    "ws": "^8.18.0"
  }
}
