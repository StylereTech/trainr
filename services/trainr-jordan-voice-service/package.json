{
  "name": "trainr-jordan-voice-service",
  "version": "1.0.0",
  "private": true,
  "description": "Persistent Twilio/OpenAI Realtime WebSocket voice service for Trainr's Jordan sales onboarding agent.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
