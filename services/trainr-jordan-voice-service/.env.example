# Required
OPENAI_API_KEY=sk-...
PUBLIC_BASE_URL=https://trainr-jordan-voice-service.fly.dev

# Optional OpenAI Realtime settings
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_REALTIME_WS_URL=wss://api.openai.com/v1/realtime

# Twilio REST credentials are only required for in-call redirects/payment handoff.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_VALIDATE_SIGNATURES=false

# Payment handoff. Do not collect raw card data in the AI socket.
TRAINR_PAYMENT_CONNECTOR=Trainr_Stripe
TRAINR_DEFAULT_PLAN_ID=trainr_onboarding
TRAINR_DEFAULT_PLAN_AMOUNT=149.00
TRAINR_CURRENCY=USD

# Existing Trainr/Clawtronics CRM endpoints. If omitted, service writes local JSONL fallback files.
TRAINR_CRM_BASE_URL=
TRAINR_CRM_API_KEY=
TRAINR_CRM_TOOL_URL=https://trainr.cc/api/voice/trainr/tools
TRAINR_VOICE_TOOL_SECRET=

# Dev/debug
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
